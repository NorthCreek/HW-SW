// alarm_ip.c
// HLS IP core implementing intrusion detection and alarm control.
// All interfaces are AXI4-Lite.

enum { INACTIVE = 0, ACTIVE = 1, ALARMED = 2 };

unsigned int alarm_ip(
    volatile unsigned int C[81],   // Camera pixels (0..9)
    unsigned int S1,               // Sensor 1 (0..5)
    unsigned int S2,               // Sensor 2 (0..5)
    unsigned int threshold,        // 0 → default 1900
    unsigned int enter_pin,        // User pressed button (1/0)
    unsigned int pin_code,         // Even = valid PIN
    unsigned int do_sample,        // CPU requests one measurement
    unsigned int reset             // Reset internal hardware state
) {
#pragma HLS INTERFACE s_axilite port=C          bundle=CTRL
#pragma HLS INTERFACE s_axilite port=S1         bundle=CTRL
#pragma HLS INTERFACE s_axilite port=S2         bundle=CTRL
#pragma HLS INTERFACE s_axilite port=threshold  bundle=CTRL
#pragma HLS INTERFACE s_axilite port=enter_pin  bundle=CTRL
#pragma HLS INTERFACE s_axilite port=pin_code   bundle=CTRL
#pragma HLS INTERFACE s_axilite port=do_sample  bundle=CTRL
#pragma HLS INTERFACE s_axilite port=reset      bundle=CTRL
#pragma HLS INTERFACE s_axilite port=return     bundle=CTRL

    // Hardware state registers (persistent in the PL)
    static unsigned char state    = INACTIVE;
    static unsigned char alarm_on = 0;
    static unsigned int  alarm_ms = 0;

    // Basic input clean-up
    unsigned int thr = (threshold == 0u) ? 1900u : threshold;

    unsigned int s1 = S1 & 0xFFu;
    if (s1 > 5u) s1 = 5u;

    unsigned int s2 = S2 & 0xFFu;
    if (s2 > 5u) s2 = 5u;

    unsigned int pin_ok  = ((pin_code & 1u) == 0u);
    unsigned int enter   = enter_pin & 1u;
    unsigned int sample  = do_sample & 1u;

    // Reset internal state
    if (reset & 1u) {
        state = INACTIVE;
        alarm_on = 0;
        alarm_ms = 0;
        return 0u;
    }

    // PIN handling (arming and acknowledging)
    if (enter && pin_ok) {
        if (state == INACTIVE) {
            state = ACTIVE;
        } else if (state == ALARMED) {
            state = ACTIVE;
            alarm_on = 0;
            alarm_ms = 0;
        }
    }

    // Main intrusion computation
    unsigned int intr_sum = 0u;

    if (sample && state == ACTIVE) {
        unsigned int sumC = 0u;

//        for (int k = 0; k < 81; ++k) {
//#pragma HLS PIPELINE II=1
//#pragma HLS LOOP_TRIPCOUNT min=81 max=81
//            unsigned int c = C[k] & 0xFFu;
//            if (c > 9u) c = 9u;
//            sumC += c;
//        }

//        for (int k = 0; k < 81; ++k) {
//        #pragma HLS UNROLL factor=9
//            unsigned int c = C[k] & 0xFFu;
//            if (c > 9u) c = 9u;
//            sumC += c;
//        }

        for (int k = 0; k < 81; ++k) {
            unsigned int c = C[k] & 0xFFu;
            if (c > 9u) c = 9u;
            sumC += c;
        }


        intr_sum = (s1 + s2) * sumC;

        if (intr_sum >= thr) {
            state = ALARMED;
            alarm_on = 1;
            alarm_ms = 0;
        }
    }

    // Alarm timeout (simulated time: one sample = 120 ms)
    if (state == ALARMED && sample) {
        alarm_ms += 120u;
        if (alarm_ms >= 10000u) {
            state = ACTIVE;
            alarm_on = 0;
            alarm_ms = 0;
        }
    }

    // Packed output:
    // [31:16] intrusion sum
    // [2] = alarm_on
    // [1:0] = state
    unsigned int out;
    out  = ((intr_sum & 0xFFFFu) << 16);
    out |= ((alarm_on & 1u) << 2);
    out |= (state & 3u);

    return out;
}


    // Return: [31:16]=intr_sum, [2]=alarm_on, [1:0]=state
    return ((intr_sum & 0xFFFFu) << 16) | ((alarm_on & 1u) << 2) | (state & 3u);
}
